# School branding
SCHOOL_NAME=Nest IT School
# Prefix for order numbers, e.g. NEST-M3K9X2
ORDER_PREFIX=NEST
# School brand colors (3- or 6-digit hex values)
SCHOOL_PRIMARY_COLOR=#5b1fa8
SCHOOL_ACCENT_COLOR=#e9c13c

# QPay config (leave empty to run in demo mode)
QPAY_USER=
QPAY_PASS=
QPAY_INVOICE_CODE=
# Optional: QPAY_BASE_URL=https://merchant.qpay.mn/v2
# Optional: QPAY_CALLBACK_URL=https://your-domain.mn/api/qpay/callback

# Database
MONGODB_URI=
MONGODB_DB_NAME=pointofsale

# S3 Configuration (product image uploads from the admin)
BUCKET_NAME=
AWS_REGION=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
CLOUDFRONT_URL=
S3_ENDPOINT=
# Optional: S3_KEY_PREFIX=school-pos/

# Admin auth (JWT). Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Optional: first admin created by `npm run seed`
# SEED_ADMIN_NAME=Сургалтын алба
# SEED_ADMIN_EMAIL=admin@school.mn
# SEED_ADMIN_PASSWORD=ChangeMe123
